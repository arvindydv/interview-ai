NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key from `supabase status` or your project's API settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where desktop installers are published, e.g. https://github.com/<org>/<repo>/releases/download/desktop-v0.1.0
NEXT_PUBLIC_DOWNLOADS_URL=
NEXT_PUBLIC_DESKTOP_VERSION=0.1.0

# Cloudflare Turnstile site key for the sign-in forms (lib/captcha.tsx). Leave empty to turn captcha off;
# when set, also turn on Turnstile in Supabase (Authentication → Attack Protection) with its secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public origin used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://friday-ai.in
# Verification codes from Google Search Console and Bing Webmaster Tools (HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Meta (Facebook) Pixel ID from Events Manager. Leave empty to turn the pixel off.
NEXT_PUBLIC_META_PIXEL_ID=
