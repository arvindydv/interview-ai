PORT=4000
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
# From `supabase status` (local) or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
# Only for projects still on the legacy HS256 JWT secret; leave empty for JWKS (asymmetric keys).
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6380
# Public website URL, used for links in emails.
APP_URL=http://localhost:3100

# Claude (https://console.anthropic.com → API keys). Without it, answers are a labelled sample.
ANTHROPIC_API_KEY=
# LLM_FAST_MODEL=claude-haiku-5-5
# LLM_VISION_MODEL=claude-sonnet-5-5

# Admin console (apps/admin, http://localhost:3200). Admin routes are disabled until all three are set.
ADMIN_EMAIL=admin@parakeet.local
# Use a long random password, e.g. `openssl rand -base64 24`.
ADMIN_PASSWORD=
# Signs admin sessions, at least 32 characters, e.g. `openssl rand -hex 32`.
ADMIN_JWT_SECRET=
# ADMIN_SESSION_HOURS=12
