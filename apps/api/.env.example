PORT=4000
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
# From `supabase status` (local) or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
# Only for projects still on the legacy HS256 JWT secret; leave empty for JWKS (asymmetric keys).
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6380
# Public website URL, used for links in emails.
APP_URL=http://localhost:3100
# Behind a reverse proxy, trust this many hops for the client IP (production compose sets 1 for Caddy).
# TRUST_PROXY=0
# Mixed into stored free-trial machine/network hashes. Set once in production; changing it forgets claims.
# DEVICE_ID_PEPPER=

# LLM: OpenRouter (https://openrouter.ai/keys) and/or Claude (https://console.anthropic.com → API keys).
# Without either, answers are a labelled sample. Model ids with a "/" go through OpenRouter, claude-* ids
# go straight to Claude. Defaults: with only OpenRouter, openai/gpt-oss-120b:nitro (fastest, ~0.6 s to
# first token) for text and anthropic/claude-sonnet-5.5 for screenshots; with Claude, Haiku and Sonnet.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# LLM_FAST_MODEL=openai/gpt-oss-120b:nitro
# LLM_VISION_MODEL=anthropic/claude-sonnet-5.5

# Live transcription: Deepgram Flux (https://console.deepgram.com → API Keys). Without it, only typed
# and screenshot questions work.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=flux-general-en            # flux-general-multi for non-English interviews
# DEEPGRAM_EOT_THRESHOLD=0.7                # 0.5–0.9: higher waits longer before treating a question as finished
# DEEPGRAM_EAGER_EOT_THRESHOLD=0.4          # 0.3–0.9: when to start answering speculatively
# DEEPGRAM_EOT_TIMEOUT_MS=2000              # end a turn after this much silence regardless

# Admin console (apps/admin, http://localhost:3200). Admin routes are disabled until all three are set.
ADMIN_EMAIL=admin@parakeet.local
# Use a long random password, e.g. `openssl rand -base64 24`.
ADMIN_PASSWORD=
# Signs admin sessions, at least 32 characters, e.g. `openssl rand -hex 32`.
ADMIN_JWT_SECRET=
# ADMIN_SESSION_HOURS=12

# Payments: Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys). Checkout is
# disabled until the key id and secret are set. Use rzp_test_ keys for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Webhooks). URL: <API>/v1/billing/webhook; events: payment.authorized,
# payment.captured, payment.failed, order.paid, refund.processed. Locally, expose the API with a tunnel.
RAZORPAY_WEBHOOK_SECRET=
