PORT=4000
CORS_ORIGINS=http://localhost:3100
# From `supabase status` (local) or your Supabase project settings.
SUPABASE_URL=http://127.0.0.1:54321
# Only for projects still on the legacy HS256 JWT secret; leave empty for JWKS (asymmetric keys).
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6380
# Public website URL, used for links in emails.
APP_URL=http://localhost:3100

# Claude (https://console.anthropic.com → API keys). Without it, answers are a labelled sample.
ANTHROPIC_API_KEY=
# LLM_FAST_MODEL=claude-haiku-5-5
# LLM_VISION_MODEL=claude-sonnet-5-5
