{
  "name": "@parakeet/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Real-Time AI Interview Assistant: desktop app (Tauri + React + Rust)",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "node --test \"test/*.test.ts\" && cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@parakeet/shared": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
