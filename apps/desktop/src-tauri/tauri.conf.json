{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Friday AI",
  "version": "0.1.1",
  "identifier": "in.friday-ai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:ui",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Friday AI",
        "url": "index.html",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#05070c",
        "contentProtected": true,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Real-time AI interview assistant",
    "longDescription": "Listens to your live interview, detects each question and shows an answer on a private overlay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "pulseaudio-utils"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "pulseaudio-utils"
        ]
      }
    }
  }
}
