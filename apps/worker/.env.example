REDIS_URL=redis://127.0.0.1:6380
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Claude, for resume analysis (same key as apps/api). Without it, resumes are used as plain text.
ANTHROPIC_API_KEY=
