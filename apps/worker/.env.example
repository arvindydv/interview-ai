REDIS_URL=redis://127.0.0.1:6380
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Resume analysis: Claude and/or OpenRouter (same keys as apps/api). Without either, resumes are used as
# plain text. Model ids with a "/" go through OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# LLM_PROFILE_MODEL=claude-sonnet-5-5           # or anthropic/claude-sonnet-5.5 via OpenRouter
# LLM_PRACTICE_MODEL=claude-sonnet-5-5          # mock interviews; defaults to LLM_PROFILE_MODEL
# LLM_TAILOR_MODEL=claude-sonnet-5-5            # Friday Jobs resume tailoring; defaults to LLM_PROFILE_MODEL

# Brevo SMTP (Brevo → SMTP & API → SMTP). Leave empty in dev to deliver to Mailpit instead.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM="Friday AI <hello@yourdomain.com>"
# EMAIL_REPLY_TO=support@yourdomain.com

# Friday Jobs search engines (optional; each is skipped until its key is set).
# Adzuna: developer.adzuna.com. Jooble: request a key at jooble.org/api/about.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Stays false until Adzuna's commercial licence is confirmed: keys alone never start syncing.
ADZUNA_SYNC_ENABLED=false
# ADZUNA_CALLS_PER_SYNC=20
JOOBLE_API_KEY=
# JOOBLE_HOST=jooble.org
# JOOBLE_CALLS_PER_SYNC=4       # once a day; the free key has 500 requests in its lifetime
# JSearch (RapidAPI, free plan 200 requests a month): Google for Jobs results, incl. LinkedIn, Naukri
# and Indeed postings. Key: rapidapi.com → subscribe to JSearch (Basic, free) → X-RapidAPI-Key.
JSEARCH_API_KEY=
# JSEARCH_CALLS_PER_SYNC=6      # one sync a day; 6 × 30 = 180 a month
# JSEARCH_DATE_POSTED=3days     # today | 3days | week | month

# Auto Apply from Friday's servers: a separate process, `pnpm --filter @parakeet/worker dev:applier`
# (not started by `pnpm dev`, as it submits real applications for every user with Auto Apply on). It
# only talks to the API; the API needs APPLIER_TOKEN_SHA256 = sha256 of this token.
# APPLIER_TOKEN=
# APPLIER_API_URL=http://127.0.0.1:4000
# AUTO_APPLY_CHROME=/usr/bin/google-chrome-stable   # default: first of chromium, google-chrome-stable found
# AUTO_APPLY_CLOUD_SLOTS=2                          # applications sent at once

# Friday Jobs cold email: recruiter and hiring manager addresses by company (hunter.io/api-keys). Optional:
# without it, only addresses in the posting or typed by the candidate are used. Cached a month per company.
HUNTER_API_KEY=
# LLM_COLD_EMAIL_MODEL=claude-sonnet-5-5

# Authorized ATS submission: encrypts employer/partner API keys (openssl rand -base64 32); same value in the API.
ATS_CREDENTIALS_KEY=
# Providers whose employer forms Friday's servers may fill (e.g. greenhouse,lever). Empty = off (default).
AUTO_APPLY_CLOUD_FORM_PROVIDERS=

# Data retention (queues/retention.ts, daily). Defaults shown; submitted applications and their resumes are never removed.
# RETENTION_EVENT_DETAIL_DAYS=90
# RETENTION_EVIDENCE_TEXT_DAYS=180
# RETENTION_UNSENT_RESUME_FILE_DAYS=30
# RETENTION_SOURCE_RUN_DAYS=90
# RETENTION_AUDIT_LOG_DAYS=400
# RETENTION_CLOSED_LISTING_DAYS=60

# Friday Jobs platform bot: accounts (comma-separated emails) that may use it. Empty: off.
# Experimental LinkedIn/Indeed/Naukri bot: off in production (platform terms). Never scheduled.
JOB_BOT_EXPERIMENTAL=false
JOB_BOT_USER_EMAILS=

# ---- Less common settings (defaults shown) ----
# NODE_ENV=development
# Links in emails: the website and the Friday Jobs site.
# APP_URL=http://localhost:3100
# JOBS_URL=http://localhost:3300
# Brevo SMTP host and port (credentials above); without credentials mail goes to the local Mailpit.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# Auto Apply's bulk tailoring and answers (default claude-haiku-5-5).
# LLM_BULK_MODEL=
# Python with PyMuPDF and python-docx (default apps/worker/.venv/bin/python, else python3).
# PYTHON_BIN=
# Experimental bot only: where sessions live, and which Chrome to use.
# JOB_BOT_HOME=~/.friday-job-bot
# JOB_BOT_CHROME=
