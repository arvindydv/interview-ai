REDIS_URL=redis://127.0.0.1:6380
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Resume analysis: Claude and/or OpenRouter (same keys as apps/api). Without either, resumes are used as
# plain text. Model ids with a "/" go through OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# LLM_PROFILE_MODEL=claude-sonnet-5-5           # or anthropic/claude-sonnet-5.5 via OpenRouter
# LLM_PRACTICE_MODEL=claude-sonnet-5-5          # mock interviews; defaults to LLM_PROFILE_MODEL
# LLM_TAILOR_MODEL=claude-sonnet-5-5            # Friday Jobs resume tailoring; defaults to LLM_PROFILE_MODEL

# Brevo SMTP (Brevo → SMTP & API → SMTP). Leave empty in dev to deliver to Mailpit instead.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM="Friday AI <hello@yourdomain.com>"
# EMAIL_REPLY_TO=support@yourdomain.com

# Friday Jobs search engines (optional; each is skipped until its key is set).
# Adzuna: developer.adzuna.com. Jooble: request a key at jooble.org/api/about.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_CALLS_PER_SYNC=20
JOOBLE_API_KEY=
# JOOBLE_HOST=jooble.org

# Auto Apply from Friday's servers: a separate process, `pnpm --filter @parakeet/worker dev:applier`
# (not started by `pnpm dev`, as it submits real applications for every user with Auto Apply on). It
# only talks to the API; the API needs APPLIER_TOKEN_SHA256 = sha256 of this token.
# APPLIER_TOKEN=
# APPLIER_API_URL=http://127.0.0.1:4000
# AUTO_APPLY_CHROME=/usr/bin/google-chrome-stable   # default: first of chromium, google-chrome-stable found
# AUTO_APPLY_CLOUD_SLOTS=2                          # applications sent at once
