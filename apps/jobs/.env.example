# Public URL of this site (canonical links). Locally the jobs site runs on :3300.
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# The main Friday site, where people create an account.
NEXT_PUBLIC_WEB_URL=http://localhost:3100
# The Edge API, called from the browser for signed-in pages.
NEXT_PUBLIC_API_URL=http://localhost:4000
# The API as server components reach it. In production the jobs container uses the internal network
# (deploy/compose.yml sets API_URL=http://api:4000).
API_URL=http://localhost:4000
# Same Supabase project as the main site, so people sign in with their Friday account.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Cloudflare Turnstile site key; must match the main site's when Supabase captcha is on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
