# Production secrets for apps/api. Copy to infra/secrets/api.env (git-ignored), fill in, then:
#   infra/scripts/push-secrets.sh api infra/secrets/api.env
# REDIS_URL and NODE_ENV are set by deploy/compose.yml; don't add them here.

# Supabase → Project Settings → API / Database.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "Session pooler" connection string (IPv4). The direct connection is IPv6-only on the free
# plan and EC2's default network can't reach it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Only for projects still on the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=https://example.com,https://admin.example.com,https://jobs.example.com
APP_URL=https://example.com

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

ADMIN_EMAIL=you@example.com
# openssl rand -base64 24
ADMIN_PASSWORD=
# openssl rand -hex 32
ADMIN_JWT_SECRET=

# Razorpay live keys (Account & Settings → API Keys) and the webhook secret (Webhooks →
# https://api.example.com/v1/billing/webhook; events payment.authorized, payment.captured,
# payment.failed, order.paid, refund.processed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Conversions API: server-side Purchase events for the website's Meta Pixel (lib/metaCapi.ts).
# Off until both are set. Token: Events Manager → the pixel → Settings → Conversions API → Generate access token.
# The token is a secret: keep it out of git, logs and the browser.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Test events code (Events Manager → Test events) to see server events there while verifying; leave empty in production.
META_CAPI_TEST_EVENT_CODE=
# Friday Jobs: live Careerjet results under searches (publisher key from careerjet.com/partners). Optional.
CAREERJET_API_KEY=

# ---- Friday Jobs application platform (docs/FRIDAY_JOBS_DEPLOYMENT.md) ----
# Same value as the worker's: the admin console stores employer ATS credentials encrypted with it.
ATS_CREDENTIALS_KEY=
# Must match the worker's list (the API routes claims by channel).
AUTO_APPLY_CLOUD_FORM_PROVIDERS=
# Signs short-lived resume download links on the Applied Jobs dashboard (openssl rand -base64 32).
DOWNLOAD_URL_SECRET=
# Public URLs used in signed links and emails.
API_PUBLIC_URL=https://api.example.com
JOBS_URL=https://jobs.example.com
# Experimental LinkedIn/Indeed/Naukri bot: must stay false in production (platform terms). Never scheduled.
JOB_BOT_EXPERIMENTAL=false
# Gmail sending for cold email (restricted scope: Google verification before public launch).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_KEY=

# ---- Also read by the API (were missing from this template) ----
# Mixed into stored device and network hashes for free-trial checks; set once, never change (changing it forgets every claim).
DEVICE_ID_PEPPER=
# Cloud Auto Apply: sha256 (hex) of the applier's APPLIER_TOKEN (applier.env). Unset: the applier routes refuse everything.
APPLIER_TOKEN_SHA256=
# Experimental bot allowlist: keep empty in production.
JOB_BOT_USER_EMAILS=
# Optional: monthly spend for cost-per-1,000-jobs in the admin console.
# JOBS_INFRA_MONTHLY_USD=
# JOBS_API_MONTHLY_USD=
# Optional overrides (defaults in apps/api/src/env.ts).
# ADMIN_SESSION_HOURS=12
# LLM_FAST_MODEL=
# LLM_VISION_MODEL=
# DEEPGRAM_MODEL=flux-general-en
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# DEEPGRAM_EOT_THRESHOLD=
# DEEPGRAM_EAGER_EOT_THRESHOLD=
# DEEPGRAM_EOT_TIMEOUT_MS=
# CAREERJET_LOCALE=en_IN
# HOST, PORT and TRUST_PROXY are set by deploy/compose.yml.
