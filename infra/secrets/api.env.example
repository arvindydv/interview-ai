# Production secrets for apps/api. Copy to infra/secrets/api.env (git-ignored), fill in, then:
#   infra/scripts/push-secrets.sh api infra/secrets/api.env
# REDIS_URL and NODE_ENV are set by deploy/compose.yml; don't add them here.

# Supabase → Project Settings → API / Database.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "Session pooler" connection string (IPv4). The direct connection is IPv6-only on the free
# plan and EC2's default network can't reach it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Only for projects still on the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=https://example.com,https://admin.example.com
APP_URL=https://example.com

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

ADMIN_EMAIL=you@example.com
# openssl rand -base64 24
ADMIN_PASSWORD=
# openssl rand -hex 32
ADMIN_JWT_SECRET=

# Razorpay live keys (Account & Settings → API Keys) and the webhook secret (Webhooks →
# https://api.example.com/v1/billing/webhook; events payment.authorized, payment.captured,
# payment.failed, order.paid, refund.processed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
