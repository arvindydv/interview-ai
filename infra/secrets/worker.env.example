# Production secrets for apps/worker. Copy to infra/secrets/worker.env (git-ignored), fill in, then:
#   infra/scripts/push-secrets.sh worker infra/secrets/worker.env
# REDIS_URL and NODE_ENV are set by deploy/compose.yml; don't add them here.

# Same Session pooler string as the API.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Required in production: Brevo → SMTP & API → SMTP.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM="Friday AI <hello@example.com>"
EMAIL_REPLY_TO=

# Friday Jobs search engines (optional; each is skipped until its key is set).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
