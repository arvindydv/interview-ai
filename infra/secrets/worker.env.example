# Production secrets for apps/worker. Copy to infra/secrets/worker.env (git-ignored), fill in, then:
#   infra/scripts/push-secrets.sh worker infra/secrets/worker.env
# REDIS_URL and NODE_ENV are set by deploy/compose.yml; don't add them here.

# Same Session pooler string as the API.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Required in production: Brevo → SMTP & API → SMTP.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM="Friday AI <hello@example.com>"
EMAIL_REPLY_TO=

# Friday Jobs search engines (optional; each is skipped until its key is set).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# ---- Friday Jobs application platform (docs/FRIDAY_JOBS_DEPLOYMENT.md) ----
# Employer/partner ATS API keys in public.ats_credentials are encrypted with this (32 bytes, base64:
# openssl rand -base64 32). MUST equal the API's. Unset: no API submission (everything else still works).
ATS_CREDENTIALS_KEY=
# Providers whose employer forms Friday's servers may fill, e.g. greenhouse,lever. Empty = off. List a
# provider only after it is approved (needs COMPOSE_PROFILES=cloud-apply and a 4 GB server too).
AUTO_APPLY_CLOUD_FORM_PROVIDERS=
# Contact finder for cold email (Hunter.io). Optional.
HUNTER_API_KEY=
# Keyed search sources stay off in production until their terms are confirmed (connectors.ts).
JSEARCH_API_KEY=
# Data retention in days (defaults shown; see apps/worker/src/queues/retention.ts).
# RETENTION_EVENT_DETAIL_DAYS=90
# RETENTION_EVIDENCE_TEXT_DAYS=180
# RETENTION_UNSENT_RESUME_FILE_DAYS=30
# RETENTION_SOURCE_RUN_DAYS=90
# RETENTION_AUDIT_LOG_DAYS=400
# RETENTION_CLOSED_LISTING_DAYS=60
# Experimental LinkedIn/Indeed/Naukri bot: never set in production (those sites' terms prohibit it).
JOB_BOT_EXPERIMENTAL=false

# ---- Also read by the worker (were missing from this template) ----
# Links in emails (Auto Apply "needs you", cold email). Defaults are localhost: set them in production.
APP_URL=https://example.com
JOBS_URL=https://jobs.example.com
# Experimental bot allowlist: keep empty in production.
JOB_BOT_USER_EMAILS=
# Optional overrides (defaults in apps/worker/src/env.ts).
# LLM_PROFILE_MODEL=
# LLM_PRACTICE_MODEL=
# LLM_TAILOR_MODEL=
# LLM_BULK_MODEL=
# LLM_COLD_EMAIL_MODEL=
# PYTHON_BIN=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# ADZUNA_SYNC_ENABLED=false
# ADZUNA_CALLS_PER_SYNC=
# JOOBLE_HOST=
# JOOBLE_CALLS_PER_SYNC=
# JSEARCH_CALLS_PER_SYNC=
# JSEARCH_DATE_POSTED=
# JOB_BOT_HOME=
# JOB_BOT_CHROME=
