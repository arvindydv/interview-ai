# Reverse proxy with automatic HTTPS (Let's Encrypt). DOMAIN and ACME_EMAIL come from deploy/compose.yml.
# DNS A records for DOMAIN, www.DOMAIN, api.DOMAIN, admin.DOMAIN and jobs.DOMAIN must point at this server first.
{
	email {$ACME_EMAIL}
}

(proxy_defaults) {
	encode zstd gzip
	header -Server
}

{$DOMAIN} {
	import proxy_defaults
	# While a container restarts during a deploy, hold requests for up to 10s instead of returning 502.
	reverse_proxy web:3100 {
		lb_try_duration 10s
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	import proxy_defaults
	# WebSockets (the live interview channel) pass through as-is. Keep them open across Caddy config
	# reloads instead of cutting every live session.
	reverse_proxy api:4000 {
		lb_try_duration 10s
		stream_close_delay 30m
	}
}

admin.{$DOMAIN} {
	import proxy_defaults
	reverse_proxy admin:3200 {
		lb_try_duration 10s
	}
}

jobs.{$DOMAIN} {
	import proxy_defaults
	reverse_proxy jobs:3300 {
		lb_try_duration 10s
	}
}
