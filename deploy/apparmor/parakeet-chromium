# AppArmor profile for the Auto Apply browser container (deploy/compose.yml, "browser"): Docker's own
# docker-default profile plus `userns`, which Ubuntu 24.04 (kernel.apparmor_restrict_unprivileged_userns=1)
# otherwise denies, and which Chrome's sandbox needs to isolate the pages it renders.
# Loaded by deploy/deploy.sh: apparmor_parser -r -W deploy/apparmor/parakeet-chromium
abi <abi/4.0>,

#include <tunables/global>

profile parakeet-chromium flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # The one addition to docker-default.
  userns,

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes and dockerd may signal container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=/usr/bin/docker,
  signal (send,receive) peer=parakeet-chromium,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Processes in the container may trace each other (Chrome's crash handler), nothing outside it.
  ptrace (trace,read,tracedby,readby) peer=parakeet-chromium,
}
